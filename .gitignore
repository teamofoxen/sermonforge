# Environment — never commit API keys
.env
.env.*

# Dependencies
node_modules/

# Vite cache
.vite/

# Build output (Vite + Electron)
dist/
dist-electron/
out/

# Electron builder output
release/
*.exe
*.dmg
*.AppImage

# Database — lives in data/ alongside the project, not in git
*.db
*.db-journal
*.db.backup*

# Editor / OS
.DS_Store
Thumbs.db
*.log
# .vscode/

# Local Claude settings (personal overrides, not project config)
.claude/settings.local.json

# Theology source texts — large data files, not source code
texts/

# Theology corpus — raw sources and derived artifacts are reproducible
# from source_url + content_sha256 + the ingest scripts. Only manifests
# are checked in. See docs/PROPOSALS/theology-corpus.md.
corpus/raw/
corpus/parsed/
corpus/chunked/

# Generated / empty data directory
src/data/

# User-generated feedback files
Feedback/

# Generated Study Guide exports (legacy repo-root path)
StudyGuides/

# Obsidian vault config — unrelated to the app
.obsidian/
