# Environment — never commit API keys
.env
.env.*

# Dependencies
node_modules/

# Vite cache
.vite/

# Build output (Vite + Electron)
dist/
dist-electron/
out/

# Electron builder output
/release/
*.exe
*.dmg
*.AppImage

# Mac icon — generated in CI from brand/icons/sermonforge.iconset (iconutil only runs on macOS).
# Source of truth is the iconset directory; never hand-edit or commit the binary.
build/icon.icns

# Database — lives in data/ alongside the project, not in git
*.db
*.db-journal
*.db.backup*

# Editor / OS
.DS_Store
Thumbs.db
*.log
# .vscode/

# Local Claude settings + runtime artifacts (personal/transient, not project config)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Theology source texts — large data files, not source code
texts/

# Theology corpus — raw sources and derived artifacts are reproducible
# from source_url + content_sha256 + the ingest scripts. Only manifests
# are checked in. See docs/PROPOSALS/theology-corpus.md.
corpus/raw/
corpus/parsed/
corpus/chunked/

# Generated / empty data directory
src/data/

# User-generated feedback files
Feedback/

# Generated Study Guide exports (legacy repo-root path)
StudyGuides/

# Obsidian vault config — unrelated to the app
.obsidian/

# Design-tool context bundles — duplicates of src/styles + src/components
# regenerated on demand for external design tools; do not commit (stale parallel copies).
design-context/
sermonforge-design-context.md
