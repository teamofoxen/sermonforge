{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sermonforge",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "sermonforge-trail",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5181", "--strictPort"],
      "port": 5181
    },
    {
      "name": "sermonforge-design",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5199", "--strictPort"],
      "port": 5199,
      "autoPort": false
    },
    {
      "name": "switchback-mock",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5180", "--directory", "tmp/switchback"],
      "port": 5180
    }
  ]
}
