{
  "name": "sermonforge",
  "version": "1.0.0",
  "description": "Sermon preparation workspace for pastors",
  "author": "SermonForge",
  "main": "electron/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "preview": "vite preview",
    "test": "vitest run",
    "spine-integrity": "node scripts/spine-integrity.js",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src electron scripts",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.9.0",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.3",
    "mammoth": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "sql.js": "^1.12.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sermonforge": "file:eslint-plugin-sermonforge",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sermonforge.app",
    "productName": "SermonForge",
    "publish": {
      "provider": "github",
      "owner": "teamofoxen",
      "repo": "sermonforge",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/@xenova/transformers/.cache/**",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/*.iobj",
      "!node_modules/better-sqlite3/build/Release/*.ipdb",
      "!node_modules/better-sqlite3/build/Release/*.pdb",
      "!node_modules/better-sqlite3/build/Release/*.exp",
      "!node_modules/better-sqlite3/build/Release/*.lib",
      "!node_modules/better-sqlite3/build/Release/test_extension.node"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/better-sqlite3/**/*",
      "node_modules/sqlite-vec/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "resources/models",
        "to": "models"
      }
    ],
    "directories": {
      "output": "C:/Projects/SermonForgeBuilds"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico",
      "artifactName": "SermonForge-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SermonForge",
      "installerHeader": "",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "mergeASARs": false,
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "artifactName": "SermonForge-Setup.dmg"
    },
    "dmg": {
      "title": "SermonForge ${version}",
      "icon": "build/icon.icns"
    }
  }
}
